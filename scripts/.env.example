# ============================================================
# Variables de entorno para scripts/test_gemini.py
# ============================================================
# Copiar este archivo a ".env" (en scripts/ o en la raíz del proyecto)
# y completar los valores. El archivo ".env" NO debe versionarse.
# ============================================================

# Clave de API de Google AI Studio (obligatoria para el script de prueba).
# Obtenerla en: https://aistudio.google.com/apikey
# No compartir la clave; mantenerla solo en el archivo ".env" local.
GEMINI_API_KEY=REEMPLAZAR_CON_TU_API_KEY

# Modelo de Gemini a usar (opcional; si se omite se usa gemini-3.6-flash).
GEMINI_MODEL=gemini-3.6-flash
