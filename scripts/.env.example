# ============================================================
# Variables de entorno para AI Shorts Factory
# ============================================================
# Copiar este archivo a ".env" (en la raíz del proyecto) y
# completar los valores. El archivo ".env" NO debe versionarse.
# ============================================================
#
# Los proveedores de IA se seleccionan mediante variables de entorno.
# Un valor vacío usa el predeterminado del código (ver comentarios).
# Los secretos (claves de API) nunca se documentan con valores reales;
# solo viven en el ".env" local, excluido de Git.

# --- Texto (LLM) -------------------------------------------------
# Clave de API de Google AI Studio. Obligatoria para los proveedores
# reales de texto, imagen (gemini) y audio (TTS).
# Obtenerla en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Proveedor de contenido: "gemini" (IA real) o "synthetic" (offline).
GEMINI_CONTENT_PROVIDER=gemini

# Modelo LLM de texto (opcional; por defecto gemini-3.6-flash).
GEMINI_MODEL=

# --- Imágenes ----------------------------------------------------
# Proveedor de imagen: "gemini" | "stability" | "synthetic" | "local-sd15".
# "synthetic" es la opción offline determinista (sin API ni red).
# "local-sd15" es Stable Diffusion 1.5 local (CUDA, Python 3.12 vía
# KOKORO_PYTHON; ver sección "Imagen local").
GEMINI_IMAGE_PROVIDER=synthetic

# Modelo de imagen (opcional; por defecto imagen-3.0-generate-002).
GEMINI_IMAGE_MODEL=

# Fallback por ejecución de imagen (ej. "stability"). Vacío = sin
# fallback. Nunca incluye "synthetic" de forma automática.
GEMINI_IMAGE_FALLBACK_PROVIDER=

# Clave de API de Stability AI (obligatoria si se usa "stability").
STABILITY_API_KEY=

# --- Imagen local (Stable Diffusion 1.5) --------------------------
# Proveedor "local-sd15": genera imágenes con SD 1.5 en .venv-kokoro
# (Python 3.12 + CUDA obligatorio). El modelo se cachea por Hugging Face
# (ver HF_HOME); no requiere API key.
# Modelo SD 1.5 (opcional; por defecto runwayml/stable-diffusion-v1-5).
LOCAL_SD15_MODEL=runwayml/stable-diffusion-v1-5
# Caché de Hugging Face del modelo (ruta absoluta fuera del repo).
LOCAL_SD15_HF_HOME=D:\ai-hf-cache
# Pasos de inferencia (opcional; por defecto 20).
LOCAL_SD15_STEPS=20
# Escala de guía (opcional; por defecto 7.5).
LOCAL_SD15_GUIDANCE=7.5

# --- Audio (TTS) --------------------------------------------------
# Proveedor de audio: "gemini" (IA real) | "synthetic" (offline
# determinista) | "kokoro" (TTS local Kokoro-82M).
# "kokoro" es offline y no requiere API key, pero necesita un intérprete
# Python 3.12 con Kokoro instalado (ver KOKORO_PYTHON más abajo).
GEMINI_AUDIO_PROVIDER=gemini

# Modelo TTS (opcional; por defecto gemini-3.1-flash-tts-preview).
GEMINI_TTS_MODEL=

# Voz TTS de Gemini (opcional; por defecto Kore).
GEMINI_TTS_VOICE=

# --- Audio local (Kokoro) -----------------------------------------
# Intérprete Python 3.12 que tiene instalado Kokoro (solo se usa con
# GEMINI_AUDIO_PROVIDER=kokoro). Ruta absoluta o relativa a la raíz del
# proyecto. Por defecto: .venv-kokoro/Scripts/python.exe
# Requisitos del entorno: Python 3.12 + "pip install kokoro[en] torch".
# El modelo/voz se descargan y cachean por Hugging Face (sin API key).
KOKORO_PYTHON=

# --- Worker outbound (ME40.4) --------------------------------------
# Identidad lógica del worker (letras/dígitos, guiones y guiones bajos;
# nunca una IP o hostname como identidad primaria).
WORKER_ID=

# Secreto compartido del protocolo worker. Vacío = auth denegada (401).
# Se lee de os.environ; nunca se imprime ni se guarda en run.json.
WORKER_TOKEN=

# URL base de la API (el worker SIEMPRE inicia la conexión; nunca abre
# puertos). Vacío = modo local de ME40.2 (polling directo del filesystem).
WORKER_API_URL=

# --- Persistencia PostgreSQL (ME40.6) --------------------------------
# URL de conexión libpq para PostgreSQLPersistenceRepository, p. ej.
# "postgresql://usuario:clave@host:5432/ai_shorts_factory".
# Vacío (por defecto) = LocalPersistenceRepository (JSON sobre el filesystem).
# El driver ("psycopg[binary]") NO está instalado en el repo; solo se usa si
# se añade explícitamente a scripts/requirements.txt y al entorno.
# Nunca se imprime ni se guarda en logs/run.json.
DATABASE_URL=

# --- Almacenamiento de artefactos (ME40.9C.2) ------------------------
# Backend del ArtifactStore del worker outbound: "local" (por defecto,
# artifacts.json en el filesystem) o "s3" (bucket S3-compatible vía boto3).
# Con "s3" son obligatorias ENDPOINT, BUCKET, ACCESS_KEY y SECRET_KEY; la
# región es opcional (por defecto "auto"). El endpoint/bucket/credenciales
# se leen de os.environ; nunca se imprimen, nunca se guardan en
# ArtifactRecord/artifacts.json y nunca se versionan con valores reales.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
