# ============================================================
# Variables de entorno para AI Shorts Factory (infraestructura n8n)
# ============================================================
# Copiar este archivo a ".env" (en la misma carpeta) y completar los valores.
# El archivo ".env" NO debe versionarse; ".env.example" sí.
#
# Diferencias entre modalidades:
#   - DESARROLLO LOCAL (Docker Compose): DB_POSTGRESDB_HOST=postgres,
#     N8N_PROTOCOL=http, N8N_SECURE_COOKIE=false, N8N_PROXY_HOPS=0.
#   - PRODUCCIÓN (Northflank): DB_POSTGRESDB_HOST=<host del addon PostgreSQL>,
#     N8N_PROTOCOL=https, N8N_SECURE_COOKIE=true, N8N_PROXY_HOPS segun CDN/proxy.
#
# Para generar valores seguros:
#   Contraseña de PostgreSQL:   openssl rand -base64 24
#   Clave de cifrado de n8n:    openssl rand -hex 32
# ============================================================

# ---------------------------------------------------------------------------
# PostgreSQL (usado por el Compose local; en Northflank la DB es un addon)
# ---------------------------------------------------------------------------
# Usuario de la base de datos de n8n.
POSTGRES_USER=n8n

# Contraseña del usuario de PostgreSQL. REEMPLAZAR con una contraseña segura.
POSTGRES_PASSWORD=REEMPLAZAR_CONTRASENA_SEGURA

# Nombre de la base de datos que usará n8n.
POSTGRES_DB=n8n

# ---------------------------------------------------------------------------
# n8n — Acceso y red
# ---------------------------------------------------------------------------
# Puerto del host donde se expondrá n8n (dentro del contenedor siempre es 5678).
N8N_PORT=5678

# Host o dominio público de n8n (sin "http://").
# Local: localhost | Producción: n8n.midominio.com
N8N_HOST=localhost

# Protocolo de acceso público. Local: http | Producción: https.
N8N_PROTOCOL=http

# URL base que usarán los webhooks públicos de n8n. Debe coincidir con el
# protocolo y host reales.
# Local: http://localhost:5678/ | Producción: https://n8n.midominio.com/
WEBHOOK_URL=http://localhost:5678/

# Cookie segura: false con HTTP (local) | true con HTTPS (producción).
N8N_SECURE_COOKIE=false

# Número de proxies inversos entre el cliente y n8n.
# Local: 0 | Producción detrás de proxy/CDN: 1 (o más).
N8N_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# n8n — Seguridad
# ---------------------------------------------------------------------------
# Clave de cifrado de las credenciales de n8n. OBLIGATORIA.
# Debe ser una cadena aleatoria larga y ÚNICA por instalación.
# Si se pierde, n8n no podrá descifrar las credenciales guardadas.
# Generar con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=REEMPLAZAR_CLAVE_DE_CIFRADO_N8N

# ---------------------------------------------------------------------------
# n8n — Base de datos
# ---------------------------------------------------------------------------
# Motor de base de datos (postgresdb).
DB_TYPE=postgresdb

# Host de PostgreSQL. Local (Compose): postgres | Producción (Northflank):
# el host del addon PostgreSQL proporcionado por la plataforma.
DB_POSTGRESDB_HOST=postgres

# Puerto de PostgreSQL (por defecto 5432).
DB_POSTGRESDB_PORT=5432

# Nombre de la base de datos (igual a POSTGRES_DB).
DB_POSTGRESDB_DATABASE=n8n

# Usuario de la base de datos (igual a POSTGRES_USER).
DB_POSTGRESDB_USER=n8n

# Contraseña de la base de datos (igual a POSTGRES_PASSWORD).
DB_POSTGRESDB_PASSWORD=REEMPLAZAR_CONTRASENA_SEGURA

# ---------------------------------------------------------------------------
# n8n — Ejecución, retención y localización
# ---------------------------------------------------------------------------
# Zona horaria de las ejecuciones programadas (ej. America/Lima, UTC, Europe/Madrid).
GENERIC_TIMEZONE=America/Lima

# Idioma por defecto de la interfaz de n8n.
N8N_DEFAULT_LOCALE=es

# Purgar los datos de ejecuciones antiguas (recomendado: true).
EXECUTIONS_DATA_PRUNE=true

# Edad máxima de una ejecución en horas antes de purgarla (336 = 14 días).
EXECUTIONS_DATA_MAX_AGE=336

# Número máximo de ejecuciones conservadas antes de purgar.
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000

# Modo de almacenamiento de datos binarios.
# default = sistema de archivos local (/home/node/.n8n). Otras opciones: s3, etc.
N8N_DEFAULT_BINARY_DATA_MODE=default

# Habilitar los runners de código de n8n (recomendado: true).
N8N_RUNNERS_ENABLED=true

# ---------------------------------------------------------------------------
# n8n — Privacidad y diagnóstico (recomendado desactivar en producción)
# ---------------------------------------------------------------------------
# Enviar datos de diagnóstico a n8n. Recomendado: false.
N8N_DIAGNOSTICS_ENABLED=false

# Personalización de la interfaz con datos de uso. Recomendado: false.
N8N_PERSONALIZATION_ENABLED=false

# Notificaciones de nuevas versiones dentro de n8n. Recomendado: false.
N8N_VERSION_NOTIFICATIONS_ENABLED=false
